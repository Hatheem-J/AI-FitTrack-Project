PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/aifittrack
JWT_SECRET=
GEMINI_API_KEY=replace_with_your_gemini_api_key
GEMINI_MODEL=gemini-3.8-flash

# Semantic Search / MongoDB Atlas Search
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_EMBEDDING_DIMENSIONS=768
EMBEDDING_BACKFILL_BATCH_SIZE=20
ATLAS_SEARCH_INDEX=workout_text_search
ATLAS_VECTOR_INDEX=workout_vector_search
ATLAS_SEARCH_ENABLED=false
ATLAS_VECTOR_SEARCH_ENABLED=false

# Optional local demo accounts used by npm run seed:demo
DEMO_USER_EMAIL=demo.user@aifittrack.local
DEMO_USER_PASSWORD=AIFitTrackDemo@12345
DEMO_ADMIN_EMAIL=demo.admin@aifittrack.local
DEMO_ADMIN_PASSWORD=AIFitTrackAdmin@12345
